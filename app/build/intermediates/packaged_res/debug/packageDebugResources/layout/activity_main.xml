                <TextView
                    android:id="@+id/tv_vpn_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#C4CAE0"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/cb_vpn"
                    style="@style/ModernSwitchSmall" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/dot_display"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginRight="10dp"
                    android:background="@drawable/dot_off" />

                <TextView
                    android:id="@+id/tv_display_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#C4CAE0"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/cb_display"
                    style="@style/ModernSwitchSmall" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/dot_notif"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginRight="10dp"
                    android:background="@drawable/dot_off" />

                <TextView
                    android:id="@+id/tv_notif_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#C4CAE0"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/cb_notif"
                    style="@style/ModernSwitchSmall" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/dot_storage"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginRight="10dp"
                    android:background="@drawable/dot_off" />

                <TextView
                    android:id="@+id/tv_storage_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#C4CAE0"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/cb_storage"
                    style="@style/ModernSwitchSmall" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
