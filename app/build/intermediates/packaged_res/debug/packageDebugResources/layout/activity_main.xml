<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_gradient"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingTop="18dp"
        android:paddingRight="16dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginRight="10dp"
                android:background="@drawable/bg_avatar_frame"
                android:padding="4dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_launcher_meow" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.12"
                    android:text="ThuyLinh"
                    android:textColor="#F8FAFC"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Meow EDITION"
                    android:textColor="#7A8395"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="7dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_show_floating"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginRight="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_top_action"
                android:text="Chọn Tự Do"
                android:textColor="#50FFC5"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_ff_normal"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="5dp"
                android:layout_marginRight="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_top_action"
                android:text="FF Normal"
                android:textColor="#50FFC5"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_ff_max"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_top_action"
                android:text="FF Max"
                android:textColor="#50FFC5"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="92dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/btn_engine"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_power_circle">

                    <ImageView
                        android:id="@+id/iv_engine_power"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="18dp"
                        android:src="@drawable/ic_power_button_outline"
                        android:tint="#E6E8F2" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/engine_status_disconnected"
                        android:textColor="#6D7286"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_selected_app"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/target_awaiting"
                        android:textColor="#555B71"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:id="@+id/dot_engine"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/dot_off" />
            </LinearLayout>

            <View
                android:id="@+id/dot_app"
                android:layout_width="0dp"
                android:layout_height="0dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card_gold"
            android:orientation="vertical"
            android:paddingTop="14dp"
            android:paddingBottom="10dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="14dp"
                android:paddingRight="14dp">

                <FrameLayout
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginRight="12dp"
                    android:background="@drawable/bg_feature_icon_green">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="♙"
                        android:textColor="#60F0AE"
                        android:textSize="20sp" />
                </FrameLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="TÂM ẢO"
                    android:textColor="#F7F7FB"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginLeft="14dp"
                android:layout_marginRight="14dp"
                android:background="#102F3341" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="24dp"
                android:paddingRight="24dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="●  FREEZE — Ngưng Đồng Thời Gian"
                    android:textColor="#40F5D0"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/cb_float_freeze"
                    style="@style/ModernSwitchSmall" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_float_freeze_status"
                android:layout_width="0dp"
                android:layout_height="0dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="24dp"
                android:paddingRight="24dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="●  GHOST — Tàng Hình"
                    android:textColor="#9B66FF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/cb_float_tele_v2"
                    style="@style/ModernSwitchSmall" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_float_tele_v2_status"
                android:layout_width="0dp"
                android:layout_height="0dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="24dp"
                android:paddingRight="24dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="●  TELEPORT — Dịch Chuyển Tức Thời"
                    android:textColor="#FFE66D"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/cb_float_tele_speed"
                    style="@style/ModernSwitchSmall" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_float_tele_speed_status"
                android:layout_width="0dp"
                android:layout_height="0dp" />

            <TextView
                android:id="@+id/cb_float_ghost"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_float_ghost_status"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/cb_float_tele"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_float_tele_status"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/cb_float_delay_ping"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_float_delay_ping_status"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/group_tele_options"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/group_tele_speed_options"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_tele_replay_delay_value"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <SeekBar
                android:id="@+id/seek_tele_replay_delay"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_tele_speed_burst_value"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <SeekBar
                android:id="@+id/seek_tele_speed_burst"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_tele_speed_sleep_value"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <SeekBar
                android:id="@+id/seek_tele_speed_sleep"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_tele_speed_catchup_status"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/cb_tele_speed_catchup"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SIZE &amp; ĐỘ MỜ TÂM ẢO"
                android:textColor="#51F3A8"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="74dp"
                    android:layout_height="wrap_content"
                    android:text="SIZE"
                    android:textColor="#778094"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <SeekBar
                    android:id="@+id/seek_crosshair_size"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:progressDrawable="@drawable/seekbar_purple_progress"
                    android:thumb="@drawable/seekbar_purple_thumb" />

                <TextView
                    android:id="@+id/tv_crosshair_size_value"
                    android:layout_width="56dp"
                    android:layout_height="wrap_content"
                    android:gravity="right"
                    android:textColor="#51F3A8"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="74dp"
                    android:layout_height="wrap_content"
                    android:text="ĐỘ MỜ"
                    android:textColor="#778094"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <SeekBar
                    android:id="@+id/seek_crosshair_alpha"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:progressDrawable="@drawable/seekbar_purple_progress"
                    android:thumb="@drawable/seekbar_purple_thumb" />

                <TextView
                    android:id="@+id/tv_crosshair_alpha_value"
                    android:layout_width="56dp"
                    android:layout_height="wrap_content"
                    android:gravity="right"
                    android:textColor="#51F3A8"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="HIỂN THỊ TÂM ẢO"
                    android:textColor="#C4CAE0"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_crosshair_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="8dp"
                    android:textColor="#778094"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/cb_crosshair"
                    style="@style/ModernSwitchSmall" />
            </LinearLayout>

            <GridLayout
                android:id="@+id/grid_crosshair_style"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="4">

                <TextView android:id="@+id/crosshair_style_dot" android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:layout_gravity="fill" android:layout_margin="3dp" android:background="@drawable/bg_crosshair_tile" android:gravity="center" android:text="DOT" android:textSize="10sp" />
                <TextView android:id="@+id/crosshair_style_cross" android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:layout_gravity="fill" android:layout_margin="3dp" android:background="@drawable/bg_crosshair_tile" android:gravity="center" android:text="CROSS" android:textSize="10sp" />
                <TextView android:id="@+id/crosshair_style_ring" android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:layout_gravity="fill" android:layout_margin="3dp" android:background="@drawable/bg_crosshair_tile" android:gravity="center" android:text="RING" android:textSize="10sp" />
                <TextView android:id="@+id/crosshair_style_dot_ring" android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:layout_gravity="fill" android:layout_margin="3dp" android:background="@drawable/bg_crosshair_tile" android:gravity="center" android:text="DOT+" android:textSize="10sp" />
                <TextView android:id="@+id/crosshair_style_sniper" android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:layout_gravity="fill" android:layout_margin="3dp" android:background="@drawable/bg_crosshair_tile" android:gravity="center" android:text="SCOPE" android:textSize="10sp" />
                <TextView android:id="@+id/crosshair_style_dynamic" android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:layout_gravity="fill" android:layout_margin="3dp" android:background="@drawable/bg_crosshair_tile" android:gravity="center" android:text="DYN" android:textSize="10sp" />
                <TextView android:id="@+id/crosshair_style_minimal" android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:layout_gravity="fill" android:layout_margin="3dp" android:background="@drawable/bg_crosshair_tile" android:gravity="center" android:text="MIN" android:textSize="10sp" />
                <TextView android:id="@+id/crosshair_style_custom" android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:layout_gravity="fill" android:layout_margin="3dp" android:background="@drawable/bg_crosshair_tile" android:gravity="center" android:text="CUSTOM" android:textSize="10sp" />
            </GridLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View android:id="@+id/crosshair_color_cyan" android:layout_width="0dp" android:layout_height="22dp" android:layout_margin="3dp" android:layout_weight="1" android:background="@drawable/swatch_cyan" />
                <View android:id="@+id/crosshair_color_green" android:layout_width="0dp" android:layout_height="22dp" android:layout_margin="3dp" android:layout_weight="1" android:background="@drawable/swatch_green" />
                <View android:id="@+id/crosshair_color_yellow" android:layout_width="0dp" android:layout_height="22dp" android:layout_margin="3dp" android:layout_weight="1" android:background="@drawable/swatch_yellow" />
                <View android:id="@+id/crosshair_color_orange" android:layout_width="0dp" android:layout_height="22dp" android:layout_margin="3dp" android:layout_weight="1" android:background="@drawable/swatch_orange" />
                <View android:id="@+id/crosshair_color_red" android:layout_width="0dp" android:layout_height="22dp" android:layout_margin="3dp" android:layout_weight="1" android:background="@drawable/swatch_red" />
                <View android:id="@+id/crosshair_color_pink" android:layout_width="0dp" android:layout_height="22dp" android:layout_margin="3dp" android:layout_weight="1" android:background="@drawable/swatch_pink" />
                <View android:id="@+id/crosshair_color_purple" android:layout_width="0dp" android:layout_height="22dp" android:layout_margin="3dp" android:layout_weight="1" android:background="@drawable/swatch_purple" />
                <View android:id="@+id/crosshair_color_white" android:layout_width="0dp" android:layout_height="22dp" android:layout_margin="3dp" android:layout_weight="1" android:background="@drawable/swatch_white" />
                <View android:id="@+id/crosshair_color_black" android:layout_width="0dp" android:layout_height="22dp" android:layout_margin="3dp" android:layout_weight="1" android:background="@drawable/swatch_black" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:gravity="center_vertical"
                android:text="ĐIỀU CHỈNH NÚT NỔI"
                android:textColor="#F7F7FB"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:text="Cỡ:"
                    android:textColor="#778094"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <SeekBar
                    android:id="@+id/seek_float_size"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:progressDrawable="@drawable/seekbar_float_progress"
                    android:thumb="@drawable/seekbar_float_thumb" />

                <TextView
                    android:id="@+id/tv_float_size_value"
                    android:layout_width="58dp"
                    android:layout_height="wrap_content"
                    android:gravity="right"
                    android:textColor="#40F5D0"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:text="Mờ:"
                    android:textColor="#778094"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <SeekBar
                    android:id="@+id/seek_float_alpha"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:progressDrawable="@drawable/seekbar_float_progress"
                    android:thumb="@drawable/seekbar_float_thumb" />

                <TextView
                    android:id="@+id/tv_float_alpha_value"
                    android:layout_width="58dp"
                    android:layout_height="wrap_content"
                    android:gravity="right"
                    android:textColor="#40F5D0"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/group_mask_options"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/cb_mask_bar"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_mask_bar_status"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_mask_bar_thickness_value"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <SeekBar
                android:id="@+id/seek_mask_bar_thickness"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_mask_bar_length_value"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <SeekBar
                android:id="@+id/seek_mask_bar_length"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/cb_auto_stop_tele"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_auto_stop_tele_status"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/cb_dev_mode"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_dev_mode_status"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QUYỀN TRUY CẬP"
                android:textColor="#51F3A8"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
