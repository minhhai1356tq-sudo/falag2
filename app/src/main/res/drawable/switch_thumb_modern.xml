<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="oval">
            <solid android:color="#FFFFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#B6FFD3" />
            <size
                android:width="26dp"
                android:height="26dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#D7DEE6" />
            <stroke
                android:width="1dp"
                android:color="#F1F5F8" />
            <size
                android:width="26dp"
                android:height="26dp" />
        </shape>
    </item>
</selector>
