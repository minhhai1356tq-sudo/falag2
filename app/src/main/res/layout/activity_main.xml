<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#04040a"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- HEADER: CYBERPUNK LOGO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:backgroundTint="#0A0A16"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:layout_marginBottom="16dp"
            android:elevation="8dp">

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginRight="12dp"
                android:background="@drawable/bg_avatar_frame"
                android:padding="4dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_launcher_meow" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MINIZO OS"
                        android:textColor="#00f3ff"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:shadowColor="#00f3ff"
                        android:shadowRadius="8" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ULTRA VIP"
                        android:background="@drawable/bg_top_action"
                        android:paddingLeft="6dp"
                        android:paddingRight="6dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:textColor="#000000"
                        android:textSize="8sp"
                        android:textStyle="bold"
                        android:layout_marginLeft="8dp" />
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SYS_VER: 1.101_HUD"
                    android:textColor="#888888"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- SECTION 1: PERMISSIONS MANAGEMENT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=">> ACCESS_PERMISSIONS"
                android:textColor="#ff007f"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:shadowColor="#ff007f"
                android:shadowRadius="4" />
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#ff007f"
                android:alpha="0.3"
                android:layout_marginLeft="8dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="86dp"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <!-- Overlay Permission -->
            <LinearLayout
                android:id="@+id/btn_perm_display"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginRight="4dp"
                android:background="@drawable/bg_card"
                android:backgroundTint="#0A0A16"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="♟"
                    android:textColor="#00f3ff"
                    android:textSize="24sp"
                    android:shadowColor="#00f3ff"
                    android:shadowRadius="6" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OVERLAY"
                    android:textColor="#E0E0E0"
                    android:textSize="9sp"
                    android:fontFamily="monospace"
                    android:layout_marginTop="4dp" />
                <View
                    android:id="@+id/dot_display"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/dot_off"
                    android:layout_marginTop="4dp" />
                <TextView android:id="@+id/tv_display_status" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <TextView android:id="@+id/cb_display" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            </LinearLayout>

            <!-- VPN Permission -->
            <LinearLayout
                android:id="@+id/btn_perm_vpn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:background="@drawable/bg_card"
                android:backgroundTint="#0A0A16"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VPN"
                    android:textColor="#00f3ff"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:shadowColor="#00f3ff"
                    android:shadowRadius="6" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TUNNEL"
                    android:textColor="#E0E0E0"
                    android:textSize="9sp"
                    android:fontFamily="monospace"
                    android:layout_marginTop="4dp" />
                <View
                    android:id="@+id/dot_vpn"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/dot_off"
                    android:layout_marginTop="4dp" />
                <TextView android:id="@+id/tv_vpn_status" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <TextView android:id="@+id/cb_vpn" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            </LinearLayout>

            <!-- Notification Permission -->
            <LinearLayout
                android:id="@+id/btn_perm_notif"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginLeft="4dp"
                android:background="@drawable/bg_card"
                android:backgroundTint="#0A0A16"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✦"
                    android:textColor="#00f3ff"
                    android:textSize="24sp"
                    android:shadowColor="#00f3ff"
                    android:shadowRadius="6" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NOTIFY"
                    android:textColor="#E0E0E0"
                    android:textSize="9sp"
                    android:fontFamily="monospace"
                    android:layout_marginTop="4dp" />
                <View
                    android:id="@+id/dot_notif"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/dot_off"
                    android:layout_marginTop="4dp" />
                <TextView android:id="@+id/tv_notif_status" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <TextView android:id="@+id/cb_notif" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            </LinearLayout>

            <View android:id="@+id/dot_storage" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <TextView android:id="@+id/tv_storage_status" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <TextView android:id="@+id/cb_storage" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        </LinearLayout>

        <!-- SECTION 2: TARGET APP SELECTION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=">> TARGET_SELECT"
                android:textColor="#ff007f"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:shadowColor="#ff007f"
                android:shadowRadius="4" />
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#ff007f"
                android:alpha="0.3"
                android:layout_marginLeft="8dp"/>
        </LinearLayout>

        <!-- CHỈ CÒN 2 NÚT FF VÀ FF MAX -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">
            
            <Button
                android:id="@+id/btn_ff_normal"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginRight="6dp"
                android:background="@drawable/bg_top_action"
                android:text="FF NORMAL"
                android:textColor="#00f3ff"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/btn_ff_max"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginLeft="6dp"
                android:background="@drawable/bg_top_action"
                android:text="FF MAX"
                android:textColor="#00f3ff"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:stateListAnimator="@null" />
        </LinearLayout>

        <!-- SECTION 3: REACTOR CORE ENGINE CONTROL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:backgroundTint="#0A0A16"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:clickable="true">

            <FrameLayout
                android:id="@+id/btn_engine"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/bg_power_circle"
                android:layout_marginRight="16dp">
                <ImageView
                    android:id="@+id/iv_engine_power"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="20dp"
                    android:src="@drawable/ic_power_button_outline"
                    android:tint="#ff007f" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tv_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OFFLINE"
                    android:textColor="#ff007f"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:shadowColor="#ff007f"
                    android:shadowRadius="8" />
                
                <TextView
                    android:id="@+id/tv_selected_app"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AWAITING_TARGET"
                    android:textColor="#888888"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:layout_marginTop="2dp" />
                    
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">
                    <View android:layout_width="6dp" android:layout_height="6dp" android:background="#00f3ff" android:layout_marginRight="6dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="HOOK: READY" android:textColor="#888888" android:textSize="9sp" android:fontFamily="monospace"/>
                </LinearLayout>
            </LinearLayout>

            <View
                android:id="@+id/dot_engine"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:background="@drawable/dot_off" />
            <View android:id="@+id/dot_app" android:layout_width="0dp" android:layout_height="0dp" />
        </LinearLayout>

        <!-- SECTION 4: MODULE OVERRIDES -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=">> MODULE_OVERRIDES"
                android:textColor="#ff007f"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:shadowColor="#ff007f"
                android:shadowRadius="4" />
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#ff007f"
                android:alpha="0.3"
                android:layout_marginLeft="8dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_gold"
            android:backgroundTint="#0A0A16"
            android:orientation="vertical"
            android:padding="10dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">
                
                <!-- FREEZE -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginRight="4dp"
                    android:background="#111111"
                    android:gravity="center_vertical"
                    android:padding="8dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="FREEZE"
                        android:textColor="#00f3ff"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace" />
                    <TextView android:id="@+id/cb_float_freeze" style="@style/ModernSwitchSmall" />
                </LinearLayout>
                <TextView android:id="@+id/tv_float_freeze_status" android:layout_width="0dp" android:layout_height="0dp" />

                <!-- GHOST V2 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginLeft="4dp"
                    android:background="#111111"
                    android:gravity="center_vertical"
                    android:padding="8dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="GHOST"
                        android:textColor="#ff007f"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace" />
                    <TextView android:id="@+id/cb_float_ghost" style="@style/ModernSwitchSmall" />
                </LinearLayout>
                <TextView android:id="@+id/tv_float_ghost_status" android:layout_width="0dp" android:layout_height="0dp" />
            </LinearLayout>

            <!-- TELEPORT -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="#111111"
                android:gravity="center_vertical"
                android:padding="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="TELEPORT"
                    android:textColor="#ffd700"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />
                <TextView android:id="@+id/cb_float_tele_speed" style="@style/ModernSwitchSmall" />
            </LinearLayout>
            <TextView android:id="@+id/tv_float_tele_speed_status" android:layout_width="0dp" android:layout_height="0dp" />

            <!-- Ẩn -->
            <TextView android:id="@+id/cb_float_tele_v2" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <TextView android:id="@+id/tv_float_tele_v2_status" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <TextView android:id="@+id/cb_float_tele" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <TextView android:id="@+id/tv_float_tele_status" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <TextView android:id="@+id/cb_float_delay_ping" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <TextView android:id="@+id/tv_float_delay_ping_status" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <LinearLayout android:id="@+id/group_tele_options" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <LinearLayout android:id="@+id/group_tele_speed_options" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <TextView android:id="@+id/tv_tele_replay_delay_value" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <SeekBar android:id="@+id/seek_tele_replay_delay" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <TextView android:id="@+id/tv_tele_speed_burst_value" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <SeekBar android:id="@+id/seek_tele_speed_burst" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <TextView android:id="@+id/tv_tele_speed_sleep_value" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <SeekBar android:id="@+id/seek_tele_speed_sleep" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <TextView android:id="@+id/tv_tele_speed_catchup_status" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <TextView android:id="@+id/cb_tele_speed_catchup" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        </LinearLayout>

        <!-- SECTION 5: VISUAL CALIBRATION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=">> VISUAL_CALIBRATION"
                android:textColor="#ff007f"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:shadowColor="#ff007f"
                android:shadowRadius="4" />
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#ff007f"
                android:alpha="0.3"
                android:layout_marginLeft="8dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:backgroundTint="#0A0A16"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginBottom="16dp">

            <!-- CROSSHAIR HUD -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CROSSHAIR HUD"
                android:textColor="#00f3ff"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:layout_marginBottom="6dp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <TextView android:layout_width="50dp" android:layout_height="wrap_content" android:text="SIZE" android:textColor="#888888" android:textSize="10sp" android:fontFamily="monospace"/>
                <SeekBar android:id="@+id/seek_crosshair_size" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:progressDrawable="@drawable/seekbar_purple_progress" android:thumb="@drawable/seekbar_purple_thumb"/>
                <TextView android:id="@+id/tv_crosshair_size_value" android:layout_width="40dp" android:layout_height="wrap_content" android:gravity="right" android:textColor="#00f3ff" android:textSize="10sp" android:fontFamily="monospace"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <TextView android:layout_width="50dp" android:layout_height="wrap_content" android:text="ALPHA" android:textColor="#888888" android:textSize="10sp" android:fontFamily="monospace"/>
                <SeekBar android:id="@+id/seek_crosshair_alpha" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:progressDrawable="@drawable/seekbar_purple_progress" android:thumb="@drawable/seekbar_purple_thumb"/>
                <TextView android:id="@+id/tv_crosshair_alpha_value" android:layout_width="40dp" android:layout_height="wrap_content" android:gravity="right" android:textColor="#00f3ff" android:textSize="10sp" android:fontFamily="monospace"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center_vertical" android:layout_marginTop="4dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="ENABLE CROSSHAIR" android:textColor="#FFFFFF" android:textSize="11sp" android:fontFamily="monospace"/>
                <TextView android:id="@+id/tv_crosshair_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#888888" android:textSize="10sp" android:layout_marginRight="6dp" android:fontFamily="monospace"/>
                <TextView android:id="@+id/cb_crosshair" style="@style/ModernSwitchSmall"/>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#222222" android:layout_marginTop="8dp" android:layout_marginBottom="8dp"/>

            <!-- FLOATING HUD WIDGET -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FLOATING HUD WIDGET"
                android:textColor="#ff007f"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:layout_marginBottom="6dp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <TextView android:layout_width="50dp" android:layout_height="wrap_content" android:text="SIZE" android:textColor="#888888" android:textSize="10sp" android:fontFamily="monospace"/>
                <SeekBar android:id="@+id/seek_float_size" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:progressDrawable="@drawable/seekbar_float_progress" android:thumb="@drawable/seekbar_float_thumb"/>
                <TextView android:id="@+id/tv_float_size_value" android:layout_width="40dp" android:layout_height="wrap_content" android:gravity="right" android:textColor="#ff007f" android:textSize="10sp" android:fontFamily="monospace"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <TextView android:layout_width="50dp" android:layout_height="wrap_content" android:text="ALPHA" android:textColor="#888888" android:textSize="10sp" android:fontFamily="monospace"/>
                <SeekBar android:id="@+id/seek_float_alpha" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:progressDrawable="@drawable/seekbar_float_progress" android:thumb="@drawable/seekbar_float_thumb"/>
                <TextView android:id="@+id/tv_float_alpha_value" android:layout_width="40dp" android:layout_height="wrap_content" android:gravity="right" android:textColor="#ff007f" android:textSize="10sp" android:fontFamily="monospace"/>
            </LinearLayout>
            
            <LinearLayout
                android:id="@+id/group_mask_options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="MASK BAR" android:textColor="#FFFFFF" android:textSize="11sp" android:fontFamily="monospace"/>
                    <TextView android:id="@+id/tv_mask_bar_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#888888" android:textSize="10sp" android:layout_marginRight="6dp" android:fontFamily="monospace"/>
                    <TextView android:id="@+id/cb_mask_bar" style="@style/ModernSwitchSmall"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <TextView android:layout_width="50dp" android:layout_height="wrap_content" android:text="THICK" android:textColor="#888888" android:textSize="10sp" android:fontFamily="monospace"/>
                    <SeekBar android:id="@+id/seek_mask_bar_thickness" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:progressDrawable="@drawable/seekbar_float_progress" android:thumb="@drawable/seekbar_float_thumb"/>
                    <TextView android:id="@+id/tv_mask_bar_thickness_value" android:layout_width="40dp" android:layout_height="wrap_content" android:gravity="right" android:textColor="#ff007f" android:textSize="10sp" android:fontFamily="monospace"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <TextView android:layout_width="50dp" android:layout_height="wrap_content" android:text="LENGTH" android:textColor="#888888" android:textSize="10sp" android:fontFamily="monospace"/>
                    <SeekBar android:id="@+id/seek_mask_bar_length" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:progressDrawable="@drawable/seekbar_float_progress" android:thumb="@drawable/seekbar_float_thumb"/>
                    <TextView android:id="@+id/tv_mask_bar_length_value" android:layout_width="40dp" android:layout_height="wrap_content" android:gravity="right" android:textColor="#ff007f" android:textSize="10sp" android:fontFamily="monospace"/>
                </LinearLayout>
            </LinearLayout>

            <TextView android:id="@+id/cb_auto_stop_tele" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <TextView android:id="@+id/tv_auto_stop_tele_status" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <TextView android:id="@+id/cb_dev_mode" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <TextView android:id="@+id/tv_dev_mode_status" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        </LinearLayout>

        <!-- 🚨 3 NÚT ẨN BẢO HIỂM (Bắt buộc phải có để code Java không bị văng) 🚨 -->
        <Button
            android:id="@+id/btn_show_floating"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <Button
            android:id="@+id/btn_start"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <Button
            android:id="@+id/btn_stop"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
